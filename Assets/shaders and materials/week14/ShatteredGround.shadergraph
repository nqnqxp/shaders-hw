{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "07e3eb617cfb483b8b8bf6bfb338ca30",
    "m_Title": "Rotation",
    "m_Content": "Because the origin of each fragment is stored via uv coordinate, we can reconstruct the location relative to the original shard's pivot. \n\nThis lets us rotate it and then *put it back* via the add operation after the rotation.",
